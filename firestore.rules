rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // User profile rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email']) 
          && data.uid == request.auth.uid 
          && data.email is string 
          && data.email.size() <= 256;
      }

      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
      
      // Contact rules
      match /contacts/{contactId} {
        function isValidContact(data) {
          return data.keys().hasAll(['userId', 'name', 'phone', 'priority'])
            && data.userId == request.auth.uid
            && data.name is string && data.name.size() <= 100
            && data.phone is string && data.phone.size() <= 20
            && data.priority is int && data.priority >= 1 && data.priority <= 3;
        }

        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidContact(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Check-in rules
      match /checkins/{checkInId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // Alert rules
    match /alerts/{alertId} {
      function isValidAlert(data) {
        return data.keys().hasAll(['userId', 'status', 'timestamp'])
          && data.userId == request.auth.uid
          && data.status in ['active', 'resolved', 'cancelled'];
      }

      // Public read for tracking (secured by alertId)
      allow get: if true; 
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidAlert(request.resource.data);
      allow update: if (isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.admin == true)) && isValidAlert(request.resource.data);

      match /locations/{locationId} {
        allow read: if true; // Public for tracking
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      }
    }
  }
}
